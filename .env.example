# ---- AI engines (picked automatically from the keys that are set) ----------
#   AI_GATEWAY_API_KEY → Jev (typesafe-ai/jev) decides, gateway agent answers with tools
#   GROQ_API_KEY only  → Groq decides, Groq agent answers with tools
#   neither            → rules only + approved templates
GROQ_API_KEY=
AI_GATEWAY_API_KEY=
# Agent on OpenRouter free models (falls back to the Groq agent if all of them fail).
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free

# ---- Database ---------------------------------------------------------------
# Empty = local SQLite file db/shop.db (created from db/schema.sql + db/seed.sql).
# For hosting, use Turso: DATABASE_URL=libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# The seed data is written for 2026-09-24; pin the date so the demo replays the same way.
SHOP_TODAY=2026-09-24

# ---- Optional -----------------------------------------------------------------
# DB_RECORD_DECISIONS=0          # don't write chat messages to conversations/agent_log
# DB_ALLOW_RESET=1               # allow "Reset demo data" on a hosted (Turso) database
# SLA_URGENT_HOURS=2  SLA_STANDARD_HOURS=24  LATE_HANDOFF_DAYS=5
# GROQ_MODEL=openai/gpt-oss-20b  GROQ_PHRASING_MODEL=openai/gpt-oss-20b   # classifier / phrasing
# AGENT_MODEL=anthropic/claude-haiku-4.5   # tool-using agent on the gateway
# GROQ_AGENT_MODEL=openai/gpt-oss-120b     # tool-using agent on Groq
# AGENT_DISABLED=1                         # fixed rule paths only, no agent
# ALLOW_TEMPLATE_FALLBACK=0     # 0 = disabled (pure AI required), 1 = allow regex template reply when keys are missing
