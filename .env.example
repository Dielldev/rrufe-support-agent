# ---- AI engines (picked automatically from the keys that are set) ----------
#   AI_GATEWAY_API_KEY → Jev (typesafe-ai/jev) decides, gateway model phrases
#   GROQ_API_KEY only  → Groq decides and phrases
#   neither            → rules only + approved templates
GROQ_API_KEY=
AI_GATEWAY_API_KEY=

# ---- Database ---------------------------------------------------------------
# Empty = local SQLite file db/shop.db (created from db/schema.sql + db/seed.sql).
# For hosting, use Turso: DATABASE_URL=libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# The seed data is written for 2026-09-24; pin the date so the demo replays the same way.
SHOP_TODAY=2026-09-24

# ---- Optional -----------------------------------------------------------------
# DB_RECORD_DECISIONS=0          # don't write chat messages to conversations/agent_log
# DB_ALLOW_RESET=1               # allow "Reset demo data" on a hosted (Turso) database
# SLA_URGENT_HOURS=2  SLA_STANDARD_HOURS=24  LATE_HANDOFF_DAYS=5
# GROQ_MODEL=openai/gpt-oss-120b  GROQ_PHRASING_MODEL=openai/gpt-oss-20b
# ALLOW_TEMPLATE_FALLBACK=0     # 0 = disabled (pure AI required), 1 = allow regex template reply when keys are missing
# DEMO_PASSWORD=                 # puts the whole site behind HTTP Basic auth
