# The engine picks itself from whichever keys are set:
#   AI_GATEWAY_API_KEY → Jev (typesafe-ai/jev) decides, gateway model phrases
#   GROQ_API_KEY only  → Groq decides and phrases
#   neither            → rules only + approved templates
# The deterministic rules and guard always make the final call.

GROQ_API_KEY=
AI_GATEWAY_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b            # decision proposals
# GROQ_PHRASING_MODEL=openai/gpt-oss-20b     # reply phrasing (separate rate-limit bucket)
# USE_AI_GATEWAY=1                           # use Vercel's OIDC token instead of an API key
# PHRASING_MODEL=anthropic/claude-haiku-4.5   # gateway phrasing model
# JEV_DISABLED=1
# GROQ_DISABLED=1
# PHRASING_DISABLED=1
